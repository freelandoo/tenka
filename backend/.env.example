# TENKA Backend — variáveis de ambiente
#
# Local: copie para `.env` e preencha. No Railway, defina como variáveis do
# serviço (DATABASE_URL vem por referência ao plugin Postgres do projeto).

# Postgres. No Railway use a referência: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenka

# Porta HTTP. O Railway injeta PORT automaticamente; localmente cai para 8080.
PORT=8080

# Origem(ns) permitida(s) no CORS (domínio do frontend no Vercel).
# Vírgula separa múltiplas. "*" libera geral (só para desenvolvimento).
CORS_ORIGIN=*

# Roda as migrations no boot do servidor. "false" desliga (rode `npm run migrate`).
RUN_MIGRATIONS_ON_BOOT=true

# Auth (F3). JWT_SECRET assina o access token — OBRIGATÓRIO em produção.
# (Localmente há um default inseguro só para não travar o boot.)
JWT_SECRET=
# Validade do access token (formato do jsonwebtoken: 15m, 1h, ...).
ACCESS_TTL=15m
# Validade do refresh token (opaco), em dias.
REFRESH_TTL_DAYS=30
# Custo do bcrypt para novas senhas (hashes migrados mantêm o seu).
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# WhatsApp / Evolution API (F9 — Atendimento)
#
# Sem EVOLUTION_URL/EVOLUTION_API_KEY o painel roda igual: a aba Atendimento
# mostra "WhatsApp não configurado" e as rotas devolvem 503. Nada quebra.
# ---------------------------------------------------------------------------

# URL INTERNA da Evolution no Railway — nunca exponha a Evolution publicamente.
EVOLUTION_URL=http://evolution-api.railway.internal:8080
# Mesma chave do AUTHENTICATION_API_KEY do serviço evolution-api.
EVOLUTION_API_KEY=
# Nome técnico da instância dentro da Evolution.
EVOLUTION_INSTANCE=tenka
# Segredo do header x-webhook-secret. OBRIGATÓRIO em produção: sem ele o
# webhook devolve 503 em vez de aceitar POST de qualquer origem.
WHATSAPP_WEBHOOK_SECRET=
# URL pública DESTE backend — é o endereço que a Evolution chama de volta.
PUBLIC_API_URL=https://tenka-production.up.railway.app

# ---------------------------------------------------------------------------
# Google Calendar / Meet (botão Reunião)
#
# OAuth de UMA conta: o admin autoriza a agenda uma vez em /painel/atendimento
# e o refresh token fica na tabela app_settings. Funciona com Gmail comum.
#
# No Google Cloud Console: criar projeto → ativar Google Calendar API →
# Credenciais → ID do cliente OAuth (Aplicativo Web) → adicionar o REDIRECT_URI
# abaixo em "URIs de redirecionamento autorizados" (tem que bater exatamente).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tenka-production.up.railway.app/google/callback
# Fuso IANA das reuniões criadas.
MEETING_TIMEZONE=America/Sao_Paulo
# Domínio do painel — para onde devolver o navegador após o consentimento.
PANEL_URL=https://tenka-brown.vercel.app
