{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/multimidia",
      "destination": "/studios",
      "permanent": true
    },
    {
      "source": "/desenvolvimento",
      "destination": "/tech",
      "permanent": true
    },
    {
      "source": "/games/jogos-de-navegador",
      "destination": "/games/advergame-e-gamificacao",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/painel/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/autorizar-cobrancas/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://*.up.railway.app; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/loja/pedido/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/innovation-week/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/innovation-week/(models|innovation-week|ar)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/studios",
      "destination": "/studios/index.html"
    },
    {
      "source": "/tech",
      "destination": "/tech/index.html"
    },
    {
      "source": "/projetos",
      "destination": "/projetos/index.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre/index.html"
    },
    {
      "source": "/contato",
      "destination": "/contato/index.html"
    },
    {
      "source": "/precos",
      "destination": "/precos/index.html"
    },
    {
      "source": "/loja",
      "destination": "/loja/index.html"
    },
    {
      "source": "/games/treinamento-em-realidade-virtual",
      "destination": "/games/treinamento-em-realidade-virtual/index.html"
    },
    {
      "source": "/games/treinamento-em-realidade-virtual/nr-35-trabalho-em-altura",
      "destination": "/games/treinamento-em-realidade-virtual/nr-35-trabalho-em-altura/index.html"
    },
    {
      "source": "/games/treinamento-em-realidade-virtual/nr-33-espaco-confinado",
      "destination": "/games/treinamento-em-realidade-virtual/nr-33-espaco-confinado/index.html"
    },
    {
      "source": "/games/treinamento-em-realidade-virtual/nr-10-seguranca-em-eletricidade",
      "destination": "/games/treinamento-em-realidade-virtual/nr-10-seguranca-em-eletricidade/index.html"
    },
    {
      "source": "/games/ativacao-de-marca-em-realidade-virtual",
      "destination": "/games/ativacao-de-marca-em-realidade-virtual/index.html"
    },
    {
      "source": "/games/advergame-e-gamificacao",
      "destination": "/games/advergame-e-gamificacao/index.html"
    },
    {
      "source": "/games/jogos-mobile",
      "destination": "/games/jogos-mobile/index.html"
    },
    {
      "source": "/studios/animacao-3d",
      "destination": "/studios/animacao-3d/index.html"
    },
    {
      "source": "/studios/maquete-eletronica-3d",
      "destination": "/studios/maquete-eletronica-3d/index.html"
    },
    {
      "source": "/studios/mockup-3d-de-produto",
      "destination": "/studios/mockup-3d-de-produto/index.html"
    },
    {
      "source": "/studios/identidade-visual-e-branding",
      "destination": "/studios/identidade-visual-e-branding/index.html"
    },
    {
      "source": "/tech/automacoes-e-agentes-de-ia",
      "destination": "/tech/automacoes-e-agentes-de-ia/index.html"
    },
    {
      "source": "/tech/sistemas-sob-medida",
      "destination": "/tech/sistemas-sob-medida/index.html"
    },
    {
      "source": "/tech/aplicativos",
      "destination": "/tech/aplicativos/index.html"
    },
    {
      "source": "/tech/sites",
      "destination": "/tech/sites/index.html"
    },
    {
      "source": "/games/treinamento-em-realidade-virtual/quanto-custa",
      "destination": "/games/treinamento-em-realidade-virtual/quanto-custa/index.html"
    },
    {
      "source": "/studios/maquete-eletronica-3d/quanto-custa",
      "destination": "/studios/maquete-eletronica-3d/quanto-custa/index.html"
    },
    {
      "source": "/studios/identidade-visual-e-branding/quanto-custa",
      "destination": "/studios/identidade-visual-e-branding/quanto-custa/index.html"
    },
    {
      "source": "/tech/sites/quanto-custa",
      "destination": "/tech/sites/quanto-custa/index.html"
    },
    {
      "source": "/tech/sistemas-sob-medida/quanto-custa",
      "destination": "/tech/sistemas-sob-medida/quanto-custa/index.html"
    },
    {
      "source": "/tech/automacoes-e-agentes-de-ia/quanto-custa",
      "destination": "/tech/automacoes-e-agentes-de-ia/quanto-custa/index.html"
    },
    {
      "source": "/tech/aplicativos/quanto-custa",
      "destination": "/tech/aplicativos/quanto-custa/index.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade/index.html"
    },
    {
      "source": "/projetos/gs-refrigeracao",
      "destination": "/projetos/gs-refrigeracao/index.html"
    },
    {
      "source": "/projetos/hidrovap",
      "destination": "/projetos/hidrovap/index.html"
    },
    {
      "source": "/projetos/excelencia-refrigeracao",
      "destination": "/projetos/excelencia-refrigeracao/index.html"
    },
    {
      "source": "/projetos/rh-climatizacao",
      "destination": "/projetos/rh-climatizacao/index.html"
    },
    {
      "source": "/projetos/vivaar-climatizacao",
      "destination": "/projetos/vivaar-climatizacao/index.html"
    },
    {
      "source": "/innovation-week/api/:path*",
      "destination": "https://inoovation-production-f1d5.up.railway.app/api/:path*"
    },
    {
      "source": "/innovation-week/membro/:token",
      "destination": "/innovation-week/membro.html"
    },
    {
      "source": "/innovation-week/membro",
      "destination": "/innovation-week/membro.html"
    },
    {
      "source": "/innovation-week/telao",
      "destination": "/innovation-week/telao.html"
    },
    {
      "source": "/innovation-week/admin/apresentacao",
      "destination": "/innovation-week/apresentacao.html"
    },
    {
      "source": "/innovation-week/admin/casa-views",
      "destination": "/innovation-week/casa-views.html"
    },
    {
      "source": "/innovation-week/casa-views",
      "destination": "/innovation-week/casa-views.html"
    },
    {
      "source": "/innovation-week/admin",
      "destination": "/innovation-week/admin.html"
    },
    {
      "source": "/innovation-week/ranking",
      "destination": "/innovation-week/ranking.html"
    },
    {
      "source": "/innovation-week/jogo",
      "destination": "/innovation-week/jogo.html"
    },
    {
      "source": "/innovation-week/privacidade",
      "destination": "/innovation-week/privacidade.html"
    },
    {
      "source": "/innovation-week",
      "destination": "/innovation-week/index.html"
    },
    {
      "source": "/innovation-week/:path*",
      "destination": "/innovation-week/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
