{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/multimidia", "destination": "/studios", "permanent": true },
    { "source": "/desenvolvimento", "destination": "/tech", "permanent": true }
  ],
  "headers": [
    {
      "source": "/painel/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/games", "destination": "/games/index.html" },
    { "source": "/studios", "destination": "/studios/index.html" },
    { "source": "/tech", "destination": "/tech/index.html" },
    { "source": "/projetos", "destination": "/projetos/index.html" },
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
